{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InviteBillingTransfer",
      "Effect": "Allow",
      "Action": [
        "organizations:InviteOrganizationToTransferResponsibility"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "organizations:TransferType": "BILLING"
        }
      }
    },
    {
      "Sid": "DescribeBillingResponsibilityTransferById",
      "Effect": "Allow",
      "Action": [
        "organizations:DescribeResponsibilityTransfer"
      ],
      "Resource": [
        "arn:aws:organizations::111111111111:transfer/o-partner6org/billing/*/rt-*"
      ],
      "Condition": {
        "StringEquals": {
          "organizations:TransferType": "BILLING"
        }
      }
    },
    {
      "Sid": "ListInboundOutboundBillingTransfers",
      "Effect": "Allow",
      "Action": [
        "organizations:ListInboundResponsibilityTransfers",
        "organizations:ListOutboundResponsibilityTransfers"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "organizations:TransferType": "BILLING"
        }
      }
    },
    {
      "Sid": "ListHandshakesForDiagnostics",
      "Effect": "Allow",
      "Action": [
        "organizations:ListHandshakesForAccount"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeHandshakesForDiagnostics",
      "Effect": "Allow",
      "Action": [
        "organizations:DescribeHandshake"
      ],
      "Resource": "arn:aws:organizations::111111111111:handshake/o-partner6org/*/h-*"
    }
  ]
}
