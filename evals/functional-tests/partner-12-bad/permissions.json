{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationStackOperations",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*"
      ],
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/partner12-ngsiem-*",
        "arn:aws:cloudformation:*:*:stackset/partner12-ngsiem*",
        "arn:aws:cloudformation:*:*:stackset-target/partner12-ngsiem-*",
        "arn:aws:cloudformation:*:*:type/resource/*"
      ]
    },
    {
      "Sid": "CloudFormationGlobalOperations",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetTemplateSummary",
        "cloudformation:ValidateTemplate",
        "cloudformation:EstimateTemplateCost"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaFunctionOperations",
      "Effect": "Allow",
      "Action": [
        "lambda:*"
      ],
      "Resource": "arn:aws:lambda:*:*:function:*Partner12Discovery*"
    },
    {
      "Sid": "IAMCreateRolePermissions",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:role/@{readerRoleName}",
        "arn:aws:iam::*:role/*Partner12DiscoverOrganization*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::partner:policy/permissions-boundary/partner12.com/partner12_ngsiem_reader_boundary_2026_04_20"
        }
      }
    },
    {
      "Sid": "IAMPassRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/*Partner12DiscoverOrganization*",
        "arn:aws:iam::*:role/@{readerRoleName}"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "cloudformation.amazonaws.com",
            "lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "IAMOtherRolePermissions",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:role/@{readerRoleName}",
        "arn:aws:iam::*:role/*Partner12DiscoverOrganization*"
      ]
    },
    {
      "Sid": "IAMPolicyPermissions",
      "Effect": "Allow",
      "Action": [
        "iam:*Policy",
        "iam:ListPolicyTags",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/partner12.com/*"
      ]
    },
    {
      "Sid": "AllowCloudFormationServiceAccessToSharedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::ngsiem-cloud-integrations/*"
    }
  ]
}
