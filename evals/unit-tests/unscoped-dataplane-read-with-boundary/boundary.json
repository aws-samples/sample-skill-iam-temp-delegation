{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:*:111111111111:key/partner-key-id-*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "kms:*"
      ],
      "NotResource": "arn:aws:kms:*:111111111111:key/partner-key-id-*"
    }
  ]
}
