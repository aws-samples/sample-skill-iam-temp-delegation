{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRoleManagement",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoles",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/partner-managed/*"
    }
  ]
}
