{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:111111111111:network-interface/*",
        "arn:aws:ec2:*:111111111111:security-group/*",
        "arn:aws:ec2:*:111111111111:subnet/*",
        "arn:aws:ec2:*:111111111111:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "partner-j"
        }
      }
    }
  ]
}
