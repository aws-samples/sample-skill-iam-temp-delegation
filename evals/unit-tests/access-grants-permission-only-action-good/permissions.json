{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateAccessGrantsInstance",
        "s3:GetAccessGrantsInstance",
        "s3:CreateAccessGrantsLocation",
        "s3:ListAccessGrantsLocations"
      ],
      "Resource": "arn:aws:s3:*:@{customerAccountId}:access-grants/default"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::@{customerAccountId}:role/partner-managed/*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::partner:policy/permissions-boundary/app.partner-n.io/PartnerNAccessGrants_2026_07_08",
          "aws:RequestTag/managed-by": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::@{customerAccountId}:role/partner-managed/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "access-grants.s3.amazonaws.com"
        }
      }
    }
  ]
}
