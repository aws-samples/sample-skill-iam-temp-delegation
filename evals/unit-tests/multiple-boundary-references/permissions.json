{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRoleA",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::@{AccountId}:role/PartnerRoleA",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::partner:policy/boundary/BoundaryA_2026_07_08"
        }
      }
    },
