{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityHubRead",
      "Effect": "Allow",
      "Action": [
        "securityhub:GetFindings",
        "securityhub:ListEnabledProductsForImport"
      ],
      "Resource": "arn:aws:securityhub:*:${aws:PrincipalAccount}:hubv2/*"
    },
    {
      "Sid": "AllowIAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::${aws:PrincipalAccount}:role/PartnerRole"
    }
  ]
}
