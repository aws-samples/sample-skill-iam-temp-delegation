{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::@{customerAccountId}:role/partner-managed/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "access-grants.s3.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:AttachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/partner-managed/*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::partner:policy/permissions-boundary/app.partner-n.io/PartnerBoundary_2026_07_08"
        }
      }
    }
  ]
}
